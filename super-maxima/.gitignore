# Super Nova: the system and the client/brand records are tracked.
# Work produced while running (videos, batches, logs, task records) and installable
# environments are not.

# macOS and Python
.DS_Store
__pycache__/
*.pyc

# Installable environments (reinstall instead of tracking)
node_modules/
.music-venv/

# Video projects and backups
Project/*
!Project/.gitkeep
Backup/*.zip

# Lark connector runtime
Lark connect/inbox/*
Lark connect/taken/*
Lark connect/done/*
Lark connect/logs/*
Lark connect/state/*
!Lark connect/*/.gitkeep

# Task records written while running
Agents/AtlasPM/batches/*
!Agents/AtlasPM/batches/.gitkeep
Agents/NovaOM/docs/atlas-runs/*
!Agents/NovaOM/docs/atlas-runs/.gitkeep
Agents/NovaOM/docs/user-scripts/*
!Agents/NovaOM/docs/user-scripts/.gitkeep
Agents/NovaOM/docs/nova-inbox/*
!Agents/NovaOM/docs/nova-inbox/done/
Agents/NovaOM/docs/nova-inbox/done/*
!Agents/NovaOM/docs/nova-inbox/done/.gitkeep
Agents/NovaOM/docs/client-monthly/*/
Agents/NovaOM/docs/nova-task-register.json
Agents/NovaOM/docs/nova-batch-queue*.json
Agents/NovaOM/docs/nova-atlas-session.json
Agents/NovaOM/docs/nova-iris.json
Agents/NovaOM/docs/nova-backups.md
Agents/EchoSD/scripts/*
Agents/EchoSD/work/*
Agents/EchoSD/adhoc/*
!Agents/EchoSD/*/.gitkeep
Agents/QuillBW/work/*
!Agents/QuillBW/work/.gitkeep
Agents/JaniBA/docs/plans/*
!Agents/JaniBA/docs/plans/.gitkeep
Agents/JaniBA/docs/jani-runs.json
Agents/HermesMU/docs/hermes-upload-log.json
Agents/CorporateCarouselDesigner/state/*
!Agents/CorporateCarouselDesigner/state/.gitkeep
Agents/IrisRP/report/iris-track-sheet.html

# Lock files and personal settings
*.lock
.claude/scheduled_tasks.lock
.claude/settings.local.json

# client-assets keeps text records and anchor character sheets only (the owner's rule,
# 2026-11-17); one-off persona, outfit and site-capture images belong in Project/.
Agents/NovaOM/client-assets/*/personas/*/outfits/
Agents/NovaOM/client-assets/*/personas/*/source/
Agents/NovaOM/client-assets/*/brand/ui/

# This machine's identity (2026-11-19): never shared, so a pull can't change who an agent is
agent.json
Lark connect/config.json
Agents/AtlasPM/docs/higgsfield-approved.json
